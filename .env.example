# ─── Gemini / AI Studio ───────────────────────────────────────────────────────
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (injected by AI Studio).
APP_URL="MY_APP_URL"

# ─── Firebase (opcional — sem estas vars o app usa localStorage) ───────────────
#
# Como obter:
#   1. Acesse https://console.firebase.google.com
#   2. Crie um projeto (ex: rattan-pdv)
#   3. Vá em Configurações do Projeto → Seus Apps → Web App → Registrar
#   4. Copie o objeto firebaseConfig e cole os valores abaixo
#   5. No console Firebase: habilite Firestore Database (modo produção ou teste)
#   6. Copie este arquivo para .env.local e preencha com seus valores reais
#
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abc123"
